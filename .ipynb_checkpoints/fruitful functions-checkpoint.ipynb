   "source": [
    "import math\n",
    "def distance(x1,x2,y1,y2):\n",
    "     x= (x2-x1)**2\n",
    "     y= (y2-y1)**2\n",
    "     return math.sqrt(x + y)\n",
    "\n",
    "distance(2,3,4,5)"
   ]
